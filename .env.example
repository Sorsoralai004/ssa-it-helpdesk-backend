# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/ssa_helpdesk

# Port the API listens on
PORT=4000

# Comma-separated origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:3000

# --- Web Push (browser notifications) ---
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@yourcompany.com

# --- Email notifications ---
# Works with Gmail (App Password), or a free-tier SMTP relay like Brevo/Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=IT Helpdesk <it@yourcompany.com>
MAIL_TO=it-team@yourcompany.com

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# --- LINE Messaging API (IT-only notifications) ---
# Keep these values secret. LINE_IT_USER_ID must be the internal U... user ID, not the Bot basic ID.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_IT_USER_ID=
